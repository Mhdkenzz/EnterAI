POSTGRES_DB=enterai
POSTGRES_USER=enterai
POSTGRES_PASSWORD=enterai_dev_password
DATABASE_URL=postgresql+psycopg://enterai:enterai_dev_password@db:5432/enterai
JWT_SECRET=replace-this-with-a-long-random-production-secret
ENVIRONMENT=production
ENABLE_API_DOCS=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Bootstrap admin account created on first boot, when no organization exists yet.
# In production the app refuses to start without a unique, non-default value here
# (see backend/app/services.py) -- the documented demo login is public in this
# repo's README and must never be reachable on a real deployment. Non-production
# environments (development/test/ci) ignore these and keep the fixed demo login
# (admin@demo.enterai.com / enterai-demo).
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=replace-this-with-a-unique-production-password
# Comma-separated browser origins allowed to call this API (CORS). Defaults to the
# local dev ports (3000, 6767) when unset -- set this to your deployed frontend's
# origin(s) in production, e.g. https://app.yourcompany.com.
CORS_ALLOWED_ORIGINS=
# The dashboard's session is an httpOnly, SameSite=Lax cookie set by the API, so the
# web app and API must share a site (same registrable domain, e.g. app.example.com and
# api.example.com, or one host behind the bundled nginx). The cookie is marked Secure
# whenever ENVIRONMENT is staging/production; browsers accept that on http://localhost,
# but set this to false if you serve a non-localhost deployment over plain http.
SESSION_COOKIE_SECURE=
# deterministic keeps development and tests offline (no external calls, no API key).
# Set AI_PROVIDER=ifm for the hosted IFM K2 Horizon API, AI_PROVIDER=anthropic
# for Anthropic, AI_PROVIDER=openrouter for a server-wide OpenRouter key (workspace
# admins can instead save an org-scoped IFM or OpenRouter key in Settings), AI_PROVIDER=lmstudio
# for LM Studio, AI_PROVIDER=ollama for local Ollama, or AI_PROVIDER=openai_compatible
# for another OpenAI-compatible /v1 endpoint
# that supports function calling. Not every local model actually emits structured
# tool_calls over an OpenAI-compatible endpoint -- some (observed: small VL models,
# some Llama/Mistral GGUF quants) print the call as plain text instead, which this
# integration reads as a plain reply rather than a tool call. Verify with a direct
# curl to /v1/chat/completions before relying on a given local model.
AI_PROVIDER=deterministic
# Optional server-wide IFM configuration when AI_PROVIDER=ifm. Workspace admins
# can instead save an encrypted IFM API key from Settings.
IFM_API_KEY=
IFM_MODEL=IFM/K2-Horizon-375B-A23B
IFM_BASE_URL=https://api.ifm.ai/v1
AGENT_EXECUTION_DAILY_STEP_LIMIT=500
# Hosted API bind-mount location containing isolated organization Git checkouts.
# docker-compose.prod.yml mounts this at AGENT_WORKSPACE_ROOT; each org uses its ID.
AGENT_WORKSPACE_HOST_PATH=/srv/enterai/workspaces
# Local development only: leave blank to use the app checkout while there is one org.
AGENT_WORKSPACE_ROOT=
AI_BASE_URL=
AI_MODEL=
# AI_API_KEY=required for AI_PROVIDER=anthropic; optional for hosted OpenAI-compatible providers
# Leave blank to use the selected model profile's timeout. Local models can take 180s.
AI_TIMEOUT_SECONDS=
# Ollama defaults: http://127.0.0.1:11434/v1, enterai-qwen3:4b.
# LM Studio defaults: http://127.0.0.1:1234/v1; set AI_MODEL to a loaded model name.
# Anthropic requires an explicit response budget; this default is higher than the old hard-coded 1,024.
AI_MAX_OUTPUT_TOKENS=8192
# Embeddings for RAG document search. "deterministic" is a SHA256-hash fake
# vector -- offline and fine for dev/tests, but not semantic, so search results
# are meaningless. Production refuses to boot-time-use it unset (see
# backend/app/embeddings.py) -- set EMBEDDING_PROVIDER=openai (requires
# OPENAI_API_KEY) or EMBEDDING_PROVIDER=local (requires sentence-transformers,
# no API key) before relying on document search in production.
EMBEDDING_PROVIDER=deterministic
# EMBEDDING_MODEL=text-embedding-3-small     # openai; or a sentence-transformers model name for local
# EMBEDDING_DIMENSION=1536                   # deterministic provider only
REDIS_URL=redis://redis:6379/0
# Uploads. `local` writes to a directory inside the container, which is fine for a
# single node but invisible to every other replica; `s3` points them all at one
# bucket instead and works against AWS S3 or any S3-compatible server. A self-hosted
# one (the `objectstore` service) is wired up in docker-compose.yml so development
# uses the same adapter as production.
STORAGE_BACKEND=s3
STORAGE_BUCKET=enterai-uploads
# Leave empty for real AWS S3; set it to the server's address otherwise (R2, the
# bundled objectstore, ...).
STORAGE_ENDPOINT_URL=http://objectstore:9000
STORAGE_REGION=us-east-1
# Credentials for the bucket above. These are also the bundled objectstore's root
# credentials in docker-compose.yml; on AWS prefer an instance role and leave them unset.
STORAGE_ACCESS_KEY=enterai_storage
STORAGE_SECRET_KEY=enterai_storage_dev_password
# Backup of uploaded files (docker-compose.prod.yml's objectstore-backup service).
# Required by production Compose. Use a separate bucket/provider, with versioning
# and lifecycle retention configured to match BACKUP_RETENTION_DAYS.
BACKUP_OBJECTS_BUCKET=enterai-uploads-backup
BACKUP_OBJECTS_ENDPOINT_URL=
BACKUP_OBJECTS_REGION=us-east-1
BACKUP_OBJECTS_ACCESS_KEY=
BACKUP_OBJECTS_SECRET_KEY=
# Off-host copy of PostgreSQL archives. Required by production Compose; keep this
# bucket separate from BACKUP_OBJECTS_BUCKET because upload mirroring prunes keys.
DATABASE_BACKUP_BUCKET=enterai-database-backups
DATABASE_BACKUP_ENDPOINT_URL=
DATABASE_BACKUP_REGION=us-east-1
DATABASE_BACKUP_ACCESS_KEY=
DATABASE_BACKUP_SECRET_KEY=
DATABASE_BACKUP_SYNC_INTERVAL_SECONDS=300
# Transactional email. Password reset, email verification and invitations are all
# delivered this way, so production refuses to start unless EMAIL_PROVIDER=smtp and
# SMTP_HOST / EMAIL_FROM / APP_BASE_URL are set -- a deployment that kept the
# console provider would appear to send them while locking users out. Development
# points at the Mailpit container in docker-compose.yml, where captured mail is
# readable at http://localhost:8025 and nothing leaves the machine.
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_STARTTLS=false
# SMTP_USERNAME / SMTP_PASSWORD are required by hosted relays (SES, SendGrid,
# Mailgun, Postmark), not by Mailpit.
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@enterai.local
# Every emailed link is built from this, so it must be the address users reach the
# app on -- not the API's address.
APP_BASE_URL=http://localhost:3000
# Optional CEO UI CLI targets. Leave blank for automatic local/API defaults;
# Docker Compose uses internal service URLs, while remote deployments can override.
ENTER_AI_BROWSER_APP_URL=
ENTER_AI_BROWSER_API_URL=
# The API's own externally-reachable address (unlike APP_BASE_URL, above, which is
# the frontend). OIDC login (Phase 14.2) registers {API_BASE_URL}/api/auth/sso/callback
# as its redirect_uri with the IdP -- that exchange sends the client secret and must
# happen server-to-server, so it must resolve to this backend, not the frontend.
API_BASE_URL=http://localhost:8000
# Gmail OAuth. Register this exact redirect URI in the Google Cloud OAuth client:
# {API_BASE_URL}/api/integrations/gmail/callback. The Gmail API must be enabled in
# that Google Cloud project. The app requests gmail.readonly only and stores mailbox
# tokens encrypted with SECRETS_ENCRYPTION_KEY.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_SYNC_INTERVAL_SECONDS=30
# Slack app OAuth. Add this OAuth Redirect URL and Events API Request URL in the
# Slack app settings:
# {API_BASE_URL}/api/integrations/slack/callback
# {API_BASE_URL}/api/integrations/slack/events
# Subscribe to message.channels, message.groups, message.im, message.mpim, and
# app_uninstalled. The bot only receives channel messages where it is a member;
# invite it to channels you want monitored.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Notion public integration OAuth. Register {API_BASE_URL}/api/integrations/notion/callback
# as its redirect URL. OAuth lets the admin choose which pages/databases to share; the
# API only reads content within that grant and polls for new/edited pages.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Encrypts recoverable application secrets at rest (OIDC client secrets, Gmail/Slack/Notion
# access/refresh tokens, and organization hosted AI keys -- see backend/app/secrets_store.py).
# Hosted use of any of these credential features requires this key. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: set a new value here, put the old value in SECRETS_ENCRYPTION_KEY_PREVIOUS,
# call POST /api/admin/sso/rotate-secrets, then remove SECRETS_ENCRYPTION_KEY_PREVIOUS.
SECRETS_ENCRYPTION_KEY=
# SECRETS_ENCRYPTION_KEY_PREVIOUS=
# Per-IP auth limits, all shared through Redis. Raise them for load testing rather
# than turning them off.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_SIGNUP_RATE_LIMIT_PER_MINUTE=5
AUTH_RECOVERY_RATE_LIMIT_PER_MINUTE=5
# Only enable behind a proxy you control that overwrites X-Forwarded-For. With it
# on, the last entry of that header identifies the caller for rate limiting; with
# it off, the socket address does. Enabling it on a directly-exposed API would let
# callers pick their own rate-limit bucket.
TRUST_PROXY_HEADERS=false

# Error reporting: any Sentry-protocol endpoint (Sentry, or self-hosted GlitchTip).
# Empty = off. Events never include cookies, auth headers, IPs or request bodies.
SENTRY_DSN=
# Billing (Stripe). Without STRIPE_SECRET_KEY, checkout and the billing portal are
# unavailable and admins see a "contact support" note. Plans are a JSON list, e.g.
# [{"name":"Team","stripe_price_id":"price_123","price_cents":2900,"currency":"USD","seat_limit":25}]
# Seat limits are per billing period; AI requests are unlimited.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PLANS=
# Every new workspace starts on a trial with these limits (0 seats = no seat cap).
TRIAL_DAYS=14
TRIAL_SEAT_LIMIT=0
