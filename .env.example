POSTGRES_DB=enterai
POSTGRES_USER=enterai
POSTGRES_PASSWORD=enterai_dev_password
DATABASE_URL=postgresql+psycopg://enterai:enterai_dev_password@db:5432/enterai
JWT_SECRET=replace-this-with-a-long-random-production-secret
ENVIRONMENT=production
ENABLE_API_DOCS=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# Bootstrap admin account created on first boot, when no organization exists yet.
# In production the app refuses to start without a unique, non-default value here
# (see backend/app/services.py) -- the documented demo login is public in this
# repo's README and must never be reachable on a real deployment. Non-production
# environments (development/test/ci) ignore these and keep the fixed demo login
# (admin@demo.enterai.com / enterai-demo).
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=replace-this-with-a-unique-production-password
# Comma-separated browser origins allowed to call this API (CORS). Defaults to the
# local dev ports (3000, 6767) when unset -- set this to your deployed frontend's
# origin(s) in production, e.g. https://app.yourcompany.com.
CORS_ALLOWED_ORIGINS=
# deterministic keeps development and tests offline (no external calls, no API key).
# Set AI_PROVIDER=anthropic for real structured tool-calling via the Anthropic Messages
# API, or AI_PROVIDER=lmstudio / openai_compatible for any OpenAI-compatible /v1 endpoint
# that supports function calling. Not every local model actually emits structured
# tool_calls over an OpenAI-compatible endpoint -- some (observed: small VL models,
# some Llama/Mistral GGUF quants) print the call as plain text instead, which this
# integration reads as a plain reply rather than a tool call. Verify with a direct
# curl to /v1/chat/completions before relying on a given local model.
AI_PROVIDER=deterministic
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=local-model
# AI_API_KEY=required for AI_PROVIDER=anthropic; optional for hosted OpenAI-compatible providers
# 20s fits a hosted API; local CPU-bound inference (LM Studio, no/limited GPU) can take
# 30-90s+ per tool-calling turn -- raise this (e.g. 90-120) for AI_PROVIDER=lmstudio or
# openai_compatible, or requests will fail with "provider unavailable" even though it's
# just slow.
AI_TIMEOUT_SECONDS=20
# Per-user cap on /api/ai/plan calls per rolling 60s window (in-process only -- see
# backend/app/ratelimit.py; move to a shared store before running multiple API replicas).
AI_PLAN_RATE_LIMIT_PER_MINUTE=20
