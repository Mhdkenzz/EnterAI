POSTGRES_DB=enterai
POSTGRES_USER=enterai
POSTGRES_PASSWORD=enterai_dev_password
DATABASE_URL=postgresql+psycopg://enterai:enterai_dev_password@db:5432/enterai
JWT_SECRET=replace-this-with-a-long-random-production-secret
ENVIRONMENT=production
ENABLE_API_DOCS=false
NEXT_PUBLIC_API_URL=http://localhost:8000/api
# deterministic keeps development and tests offline. Set AI_PROVIDER=lmstudio
# or openai_compatible for any OpenAI-compatible /v1 endpoint.
AI_PROVIDER=deterministic
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=local-model
# AI_API_KEY=only-needed-for-hosted-providers
AI_TIMEOUT_SECONDS=20
